# Copy to .env (git ignores it) and fill in YOURSELF. Never commit or paste real values anywhere else.
# Every variable below without a "Optional" mark is required: the server refuses to start without it.

# ---- Public address ----
# No trailing slash. https required, except http://localhost:PORT for local runs.
BASE_URL=http://localhost:8080

# ---- Google sign-in ----
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application
#   Authorized redirect URI: <BASE_URL>/auth/google/callback
#   (OAuth consent screen: scopes openid, email, profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Google Drive: where saved invites go ----
# 1. Cloud Console: enable "Google Drive API", then IAM & Admin > Service Accounts > Create.
#    Create a JSON key for it (Keys > Add key). Do not commit that file; copy the two values below from it.
# 2. In Google Drive, add the service account email as a member (Content manager / Editor) of the Shared Drive.
#    Create a folder in that Shared Drive for the invites.
# 3. DRIVE_FOLDER_ID is the last part of the folder URL: https://drive.google.com/drive/folders/<DRIVE_FOLDER_ID>
DRIVE_FOLDER_ID=
# "client_email" from the JSON key
DRIVE_SA_EMAIL=
# "private_key" from the JSON key, in double quotes on ONE line, keeping the \n escapes as they are:
# DRIVE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
DRIVE_SA_PRIVATE_KEY=

# ---- Optional ----
# PORT=8080
# HOST=127.0.0.1
# DB_PATH=data/hennha.db
# STATIC_DIR=dist
# TRUST_PROXY=1
